# ComfyUI-AI-Photography-Toolkit Debug Configuration
# Copy this file to .env and fill in values to enable debug mode

# Enable debug analysis (compares source image to generated prompt using Claude)
# Set to "true" to enable, anything else disables
DEBUG_ENABLED=false

# Anthropic API key for Claude analysis
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx
