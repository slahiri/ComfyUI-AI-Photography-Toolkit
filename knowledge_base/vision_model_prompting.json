{
  "version": "1.0.0",
  "last_updated": "2025-12-14T00:00:00Z",
  "description": "General vision model prompting guidelines",

  "general_principles": {
    "clarity": {
      "description": "Be specific and unambiguous in descriptions",
      "importance": "high",
      "examples": {
        "good": [
          "red floral dress with small white roses",
          "dark brown leather jacket with silver zipper",
          "light blue denim jeans with visible wear at knees"
        ],
        "bad": [
          "nice dress with pattern",
          "cool jacket",
          "jeans"
        ]
      }
    },
    "hierarchy": {
      "description": "Order information by importance",
      "importance": "high",
      "recommended_order": [
        "Subject (who/what)",
        "Key attributes (clothing, appearance)",
        "Action/pose",
        "Environment/setting",
        "Lighting",
        "Style/technical quality"
      ]
    },
    "concreteness": {
      "description": "Use concrete visual terms, not abstract concepts",
      "importance": "high",
      "examples": {
        "good": [
          "warm golden sunlight from the right",
          "shoulder-length wavy brown hair",
          "standing with weight on left leg"
        ],
        "bad": [
          "beautiful lighting",
          "nice hair",
          "casual pose"
        ]
      }
    },
    "consistency": {
      "description": "Maintain consistent style and terminology throughout",
      "importance": "medium",
      "tips": [
        "Use the same level of detail for all elements",
        "Don't mix keyword style with sentence style",
        "Keep tense consistent (present tense preferred)"
      ]
    }
  },

