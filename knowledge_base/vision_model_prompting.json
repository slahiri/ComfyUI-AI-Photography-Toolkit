  "common_issues": {
    "hands": {
      "problem": "Malformed hands are common across most models",
      "severity": "high",
      "mitigation_strategies": [
        "Specify hand position clearly when important",
        "Hide hands in pose when not critical (hands in pockets, behind back)",
        "Use inpainting for correction",
        "Include 'detailed hands' or 'correct hand anatomy' in prompt",
        "Consider hand-focused LoRAs for SDXL"
      ]
    },
    "text": {
      "problem": "Text in images often garbled or misspelled",
      "severity": "medium",
      "mitigation_strategies": [
        "Use models with good text (Flux, SD3)",
        "Keep text short and simple",
        "Use inpainting to fix text",
        "Consider adding text in post-processing"
      ]
    },
    "multiple_subjects": {
      "problem": "Features may mix between multiple people",
      "severity": "medium",
      "mitigation_strategies": [
        "Clear separation in description ('on the left... on the right')",
        "Distinct attributes for each person",
        "Use regional prompting if supported",
        "Consider compositing multiple images"
      ]
    },
    "anatomy": {
      "problem": "Body proportions or anatomy errors",
      "severity": "medium",
      "mitigation_strategies": [
        "Specify body type and proportions",
        "Use anatomy-focused negative prompts",
        "Reference real poses",
        "Full body shots need more attention"
      ]
    },
    "lighting_consistency": {
      "problem": "Light direction may be inconsistent",
      "severity": "low",
      "mitigation_strategies": [
        "Specify light direction explicitly",
        "Include shadow direction in prompt",
        "Reference real lighting setups"
      ]
    }
  },

  "prompt_engineering_techniques": {
    "weight_emphasis": {
      "description": "Using syntax to emphasize certain terms",
      "supported_by": ["SDXL", "SD1.5", "Some Flux variants"],
      "syntax": "(term:weight) or (term)",
      "examples": [
        "(detailed eyes:1.2)",
        "((important feature))",
        "(less important:0.8)"
      ],
      "tips": [
        "Don't over-emphasize - subtle weights work best",
        "1.0-1.3 range is usually sufficient",
        "Test without weights first"
      ]
    },
    "negative_prompts": {
      "description": "Specifying what to avoid",
      "supported_by": ["SDXL", "SD1.5", "SD3"],
      "common_negatives": [
        "blurry, out of focus",
        "deformed, distorted",
        "bad anatomy, bad hands",
        "low quality, jpeg artifacts",
        "watermark, signature"
      ],
      "tips": [
        "Keep negative prompts relevant to actual issues",
        "Don't copy-paste massive negative prompt lists",
        "Some models work better without negatives"
      ]
    },
    "style_references": {
      "description": "Referencing artistic styles or photographers",
      "examples": [
        "in the style of Annie Leibovitz",
        "cinematic lighting like Roger Deakins",
        "editorial fashion photography"
      ],
      "tips": [
        "More specific references work better",
        "Combine with technical terms for best results"
      ]
    }
  },

  "quality_checklist": {
    "before_generation": [
      "Is the subject clearly identified?",
      "Are key visual attributes specified?",
      "Is the environment/setting described?",
      "Is the lighting mentioned?",
      "Is the prompt appropriate length for the model?",
      "Are vague terms replaced with specifics?",
      "Is the prompt free of contradictions?"
    ],
    "evaluating_output": [
      "Does the subject match the description?",
      "Are colors accurate?",
      "Is the lighting consistent?",
      "Are there anatomical issues?",
      "Is the composition as intended?",
      "Are there artifacts or quality issues?",
      "Does it match the intended style?"
    ]
  }
}
